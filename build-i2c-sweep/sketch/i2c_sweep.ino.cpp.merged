// Standalone BME280/I2C diagnostic. No production firmware or radio libraries.
#include <Arduino.h>
#include <Wire.h>
#include <math.h>
#include <string.h>

namespace {
constexpr int SDA_PIN = 21, SCL_PIN = 22;
constexpr uint32_t SPEEDS[] = {400000, 200000, 100000, 50000, 25000, 10000};
constexpr unsigned SPEED_COUNT = sizeof(SPEEDS) / sizeof(SPEEDS[0]);
constexpr uint32_t SAMPLE_MS = 200;
constexpr unsigned SWEEP_ATTEMPTS = 50, CONFIRM_ATTEMPTS = 300;
enum class Phase { Sweep, Confirm, Monitor, Failed };
Phase phase = Phase::Failed;
unsigned speedIndex = 0, attempts = 0, good = 0, bad = 0;
uint32_t runStarted = 0, phaseStarted = 0, nextSample = 0;
uint8_t address = 0;
uint16_t digT1 = 0;
int16_t digT2 = 0, digT3 = 0;
bool initialized = false, phaseSetupOk = false, clockSetOk = false;
char command[24] = {};
unsigned commandLength = 0;

struct Failure {
  const char *reason = "ok", *operation = "none";
  int reg = -1, wireStatus = -1;
  unsigned expected = 0, received = 0;
} failure;

const char *phaseName() {
  return phase == Phase::Sweep ? "sweep" : phase == Phase::Confirm ? "confirm" :
         phase == Phase::Monitor ? "monitor" : "failed";
}

bool fail(const char *reason, const char *operation, int reg = -1,
          int wireStatus = -1, unsigned expected = 0, unsigned received = 0) {
  failure = {reason, operation, reg, wireStatus, expected, received};
  return false;
}

bool writeRegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(address);
  Wire.write(reg);
  Wire.write(value);
  const uint8_t status = Wire.endTransmission(true);
  return status == 0 || fail("i2c_write_failed", "write", reg, status, 2, 0);
}

bool readRegisters(uint8_t reg, uint8_t *data, uint8_t count) {
  Wire.beginTransmission(address);
  Wire.write(reg);
  // Match the BME280 register-read transaction in the production firmware.
  const uint8_t status = Wire.endTransmission(false);
  if (status != 0)
    return fail("i2c_register_select_failed", "select", reg, status, count, 0);
  const unsigned received = Wire.requestFrom(address, count);
  if (received != count) {
    while (Wire.available()) Wire.read();
    return fail("i2c_short_read", "read", reg, status, count, received);
  }
  for (unsigned i = 0; i < count; ++i) data[i] = Wire.read();
  return true;
}

constexpr double compensateTemperature(uint32_t raw, uint16_t t1, int16_t t2, int16_t t3) {
  // Bosch BME280 datasheet 8.1: double-precision temperature compensation.
  const double v1 = (double(raw) / 16384.0 - double(t1) / 1024.0) * double(t2);
  const double x = double(raw) / 131072.0 - double(t1) / 8192.0;
  return (v1 + x * x * double(t3)) / 5120.0;
}
static_assert(compensateTemperature(519888, 27504, 26435, -1000) > 25.08 &&
              compensateTemperature(519888, 27504, 26435, -1000) < 25.09,
              "Temperature compensation reference vector");

bool initializeSensor() {
  // Discovery NACKs at unused addresses are logged, not counted as failed samples.
  address = 0;
  for (const uint8_t candidate : {uint8_t(0x76), uint8_t(0x77)}) {
    Wire.beginTransmission(candidate);
    const uint8_t status = Wire.endTransmission(true);
    Serial.printf("# PROBE,address=0x%02X,wire_status=%u\n", candidate, status);
    if (status == 0) { address = candidate; break; }
  }
  if (!address) return fail("bme280_not_found", "probe");
  uint8_t id;
  if (!readRegisters(0xD0, &id, 1)) return false;
  if (id != 0x60) return fail("wrong_chip_id", "identity", 0xD0);
  if (!writeRegister(0xE0, 0xB6)) return false;
  delay(10);
  const uint32_t started = millis();
  uint8_t status;
  do {
    if (!readRegisters(0xF3, &status, 1)) return false;
    if (!(status & 1)) break;
    if (millis() - started >= 100) return fail("calibration_copy_timeout", "status", 0xF3);
    delay(1);
  } while (true);
  uint8_t calibration[6], check[6];
  if (!readRegisters(0x88, calibration, 6) || !readRegisters(0x88, check, 6)) return false;
  if (memcmp(calibration, check, 6)) return fail("calibration_reads_differ", "calibration", 0x88);
  digT1 = uint16_t(calibration[0]) | (uint16_t(calibration[1]) << 8);
  digT2 = int16_t(uint16_t(calibration[2]) | (uint16_t(calibration[3]) << 8));
  digT3 = int16_t(uint16_t(calibration[4]) | (uint16_t(calibration[5]) << 8));
  if (!digT1 || digT1 == 0xFFFF) return fail("invalid_calibration", "calibration", 0x88);
  // Temperature x1, pressure/humidity skipped, no filter, forced mode per sample.
  if (!writeRegister(0xF2, 0) || !writeRegister(0xF4, 0x20) || !writeRegister(0xF5, 0)) return false;
  uint8_t humidity, control, config;
  if (!readRegisters(0xF2, &humidity, 1) || !readRegisters(0xF4, &control, 1) ||
      !readRegisters(0xF5, &config, 1)) return false;
  if (humidity != 0 || control != 0x20 || config != 0)
    return fail("configuration_readback_failed", "configure", 0xF4);
  return true;
}

void beginPhase(Phase requested) {
  phase = requested;
  attempts = good = bad = 0;
  phaseStarted = nextSample = millis();
  Serial.printf("# PHASE,name=%s,clock_hz=%lu,target_samples=%u\n", phaseName(),
                (unsigned long)Wire.getClock(), phase == Phase::Sweep ? SWEEP_ATTEMPTS : CONFIRM_ATTEMPTS);
}

void beginSpeed() {
  Wire.end();
  address = 0;
  clockSetOk = Wire.begin(SDA_PIN, SCL_PIN, SPEEDS[speedIndex]);
  Wire.setTimeOut(20);
  clockSetOk = clockSetOk && Wire.setClock(SPEEDS[speedIndex]);
  clockSetOk = clockSetOk && Wire.getClock() == SPEEDS[speedIndex];
  failure = Failure{};
  initialized = clockSetOk ? initializeSensor() : fail("clock_configuration_failed", "clock");
  phaseSetupOk = initialized;
  beginPhase(Phase::Sweep);
  Serial.printf("# INIT,requested_hz=%lu,actual_hz=%lu,address=0x%02X,ok=%u,reason=%s,operation=%s,register=%d,wire_status=%d,expected=%u,received=%u\n",
                (unsigned long)SPEEDS[speedIndex], (unsigned long)Wire.getClock(), address,
                unsigned(initialized), failure.reason, failure.operation, failure.reg,
                failure.wireStatus, failure.expected, failure.received);
}

void startRun() {
  runStarted = millis();
  speedIndex = 0;
  Serial.println("# RUN_START,i2c_sweep_v1");
  Serial.println("record,run_ms,phase,clock_hz,address,attempt,temperature_c,raw_temperature,result,operation,register,wire_status,expected_bytes,received_bytes,duration_us");
  beginSpeed();
}

void slower() {
  if (++speedIndex < SPEED_COUNT) beginSpeed();
  else {
    phase = Phase::Failed;
    Serial.println("# RESULT,FAIL,reason=no_clean_speed");
  }
}

bool measure(double &temperature, uint32_t &raw) {
  if (!initialized) return false; // Preserve the exact initialization failure.
  failure = Failure{};
  if (!writeRegister(0xF4, 0x21)) return false;
  // Temperature-only x1 needs ~2.3 ms; allow 5 ms before polling completion.
  delay(5);
  const uint32_t started = millis();
  uint8_t status;
  do {
    if (!readRegisters(0xF3, &status, 1)) return false;
    if (!(status & 0x09)) break;
    if (millis() - started >= 80) return fail("conversion_timeout", "status", 0xF3);
    delay(1);
  } while (true);
  uint8_t data[3];
  if (!readRegisters(0xFA, data, 3)) return false;
  raw = (uint32_t(data[0]) << 12) | (uint32_t(data[1]) << 4) | (data[2] >> 4);
  if (raw == 0x80000) return fail("temperature_channel_skipped", "temperature", 0xFA);
  temperature = compensateTemperature(raw, digT1, digT2, digT3);
  if (!isfinite(temperature) || temperature < -40 || temperature > 85)
    return fail("temperature_out_of_range", "temperature", 0xFA);
  return true;
}

void sample() {
  const uint32_t started = micros();
  double temperature = NAN;
  uint32_t raw = UINT32_MAX;
  const bool ok = measure(temperature, raw);
  ++attempts;
  if (ok) ++good; else ++bad;
  Serial.printf("sample,%lu,%s,%lu,0x%02X,%u,", (unsigned long)(millis() - runStarted),
                phaseName(), (unsigned long)Wire.getClock(), address, attempts);
  if (ok) Serial.print(temperature, 5);
  Serial.print(',');
  if (raw != UINT32_MAX) Serial.print(raw);
  Serial.printf(",%s,%s,%d,%d,%u,%u,%lu\n",
                failure.reason, failure.operation, failure.reg, failure.wireStatus,
                failure.expected, failure.received, (unsigned long)(micros() - started));
}

void summary() {
  Serial.printf("# SUMMARY,phase=%s,clock_hz=%lu,attempts=%u,ok=%u,errors=%u,setup_ok=%u,elapsed_ms=%lu\n",
                phaseName(), (unsigned long)Wire.getClock(), attempts, good, bad,
                unsigned(phaseSetupOk), (unsigned long)(millis() - phaseStarted));
}
} // namespace

void setup() {
  Serial.begin(115200);
  delay(750);
  Serial.println("# BME280 only; SDA=21; SCL=22; send START to restart the sweep");
  startRun();
}

void loop() {
  while (Serial.available()) {
    const char c = Serial.read();
    if (c == '\n') {
      command[commandLength] = 0;
      if (!strcmp(command, "START")) startRun();
      commandLength = 0;
    } else if (c != '\r') {
      if (commandLength < sizeof(command) - 1) command[commandLength++] = c;
      else commandLength = 0;
    }
  }
  if (phase == Phase::Failed) { delay(1); return; }
  const unsigned target = phase == Phase::Sweep ? SWEEP_ATTEMPTS : CONFIRM_ATTEMPTS;
  if ((phase == Phase::Monitor || attempts < target) && int32_t(millis() - nextSample) >= 0) {
    sample();
    nextSample += SAMPLE_MS;
    // A delayed loop is an explicit failed schedule, never hidden by burst reads.
    if (int32_t(millis() - nextSample) >= 0) {
      phaseSetupOk = false;
      Serial.println("# SCHEDULE_ERROR,reason=missed_200ms_deadline");
      nextSample = millis() + SAMPLE_MS;
    }
    if (phase == Phase::Confirm && bad) { summary(); slower(); return; }
  }
  const uint32_t elapsed = millis() - phaseStarted;
  if (phase == Phase::Sweep && elapsed >= 10000 && attempts >= SWEEP_ATTEMPTS) {
    summary();
    if (good == SWEEP_ATTEMPTS && !bad && phaseSetupOk) beginPhase(Phase::Confirm);
    else slower();
  } else if (phase == Phase::Confirm && elapsed >= 60000 && attempts >= CONFIRM_ATTEMPTS) {
    summary();
    if (good == CONFIRM_ATTEMPTS && !bad && phaseSetupOk) {
      Serial.printf("# RESULT,PASS,clock_hz=%lu,confirm_ok=%u,confirm_errors=%u\n",
                    (unsigned long)Wire.getClock(), good, bad);
      beginPhase(Phase::Monitor);
    } else slower();
  }
  delay(1);
}

